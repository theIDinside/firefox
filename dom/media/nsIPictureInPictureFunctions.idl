#include "nsISupports.idl"

webidl Element;
webidl PictureInPictureWindow;

[scriptable, uuid(b6d8b8d7-8b81-493d-806d-fb10072e3afd)]
interface nsIPictureInPictureFunctions : nsISupports {
    [implicit_jscontext]
    Promise OpenPictureInPictureWindow(in Element videoElement, in PictureInPictureWindow pictureInPictureWindow);

    [implicit_jscontext]
    Promise ClosePictureInPictureWindow(in Element videoElement);
};
